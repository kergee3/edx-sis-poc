# Database — Turso (全テーブル: 認証 / ログイン履歴 / ユーザ設定)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=
# 本番 (Vercel) のみ設定: AUTH_URL=https://oauth-callback.example.com
# ローカルは AUTH_URL は空で可（NEXTAUTH_URL を使う）
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000

# バグ報告 (ヘッダの 🐞 ボタン → スクショ + GitHub Issue 自動起票)
# GITHUB_TOKEN: kergee3/edx-sis-poc に対する fine-grained PAT (Issues: Read and write)
# GITHUB_REPO: 起票先リポジトリ ("owner/name" 形式)
# ※ ラベル bug / enhancement / user-report はリポジトリに事前作成しておくこと
#   (GitHub REST は未存在ラベルを自動作成しない)
GITHUB_TOKEN=
GITHUB_REPO=kergee3/edx-sis-poc

# Vercel Blob (バグ報告のスクショ保存先)。Vercel の Blob ストアから取得
BLOB_READ_WRITE_TOKEN=

# 値を設定せずにビルドだけ通したい場合のエスケープハッチ（本番では未設定にする）
# SKIP_ENV_VALIDATION=1
