# Database — Turso (全テーブル: 認証 / ログイン履歴 / ユーザ設定)
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_LINE_ID=
AUTH_LINE_SECRET=
# 本番 (Vercel) のみ設定: AUTH_URL=https://sis-poc.shumy.app
# ローカルは AUTH_URL は空で可（NEXTAUTH_URL を使う）
AUTH_URL=
NEXTAUTH_URL=http://localhost:3000

# 値を設定せずにビルドだけ通したい場合のエスケープハッチ（本番では未設定にする）
# SKIP_ENV_VALIDATION=1
